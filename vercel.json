{
  "version": 2,
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__path=/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/build/web/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/market/refresh",
      "schedule": "0 18 * * *"
    }
  ]
}